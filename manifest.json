{
  "schemaVersion": 1,
  "id": "io.github.han-rucan.omarot13",
  "name": "ROT13",
  "version": "0.1.0",
  "author": "Antonio Ruccia",
  "license": "MIT",
  "description": "ROT13 the selected text (or the clipboard) from a bar click or a keybinding.",
  "kinds": [
    "bar-widget"
  ],
  "entryPoints": {
    "barWidget": "BarWidget.qml"
  },
  "barWidget": {
    "displayName": "ROT13",
    "description": "Click to ROT13 the selected text (falls back to the clipboard) and copy the result.",
    "category": "Utilities",
    "allowMultiple": false,
    "defaultSection": "right",
    "defaults": {
      "label": "R13"
    },
    "schema": [
      {
        "key": "label",
        "type": "string",
        "label": "Label"
      }
    ]
  },
  "homepage": "https://github.com/han-rucan/omarot13",
  "repository": "https://github.com/han-rucan/omarot13"
}
